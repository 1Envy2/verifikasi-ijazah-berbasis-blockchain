# Koneksi PostgreSQL (Sesuaikan dengan kredensial lokal Anda)
DATABASE_URL="postgresql://username:password@localhost:5432/portal_internal_blockchain_ijazah?schema=public"

# Konfigurasi Backend Signing (Institusi)
# Private Key Rektorat/Institusi untuk menandatangani transaksi ke Besu
INSTITUTION_PRIVATE_KEY="0x..."

# RPC URL Node Rektorat di jaringan Hyperledger Besu
BESU_RPC_URL="http://127.0.0.1:8545"

# Alamat Smart Contract IjazahRegistry yang sudah di-deploy
SMART_CONTRACT_ADDRESS="0x..."

